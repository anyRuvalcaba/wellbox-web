# Supabase project (Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Stripe — modo de prueba (Developers > API keys en el dashboard de Stripe).
# La secreta NUNCA debe llegar al navegador: no lleva el prefijo NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_tu-llave-secreta
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_tu-llave-publicable
# Solo si se configura el webhook (stripe listen / dashboard).
STRIPE_WEBHOOK_SECRET=whsec_tu-secreto-de-webhook

# Llave de servicio de Supabase (Project Settings > API > service_role).
# SALTA TODAS LAS POLÍTICAS RLS. Solo la usa el webhook de Stripe, que llega sin sesión.
# Nunca debe llevar el prefijo NEXT_PUBLIC_ ni exponerse al navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-llave-de-servicio
